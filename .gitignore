# ==========================================
# ROOT .gitignore (Global Rules)
# ==========================================

# Environment variables (CRITICAL: Never push these)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Dependencies
node_modules/

# Builds
dist/
build/

# OS Files
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.vscode/
.idea/
*.swp

# ==========================================
# Sub-folder rules (Prevents accidental pushes)
# ==========================================
client/node_modules/
client/dist/
admin/node_modules/
admin/dist/
server/node_modules/

# Uploads (User-generated content)
server/uploads/